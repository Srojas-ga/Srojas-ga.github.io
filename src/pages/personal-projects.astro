---
import Header from '../components/Header.astro';
import Project from '../components/Project.astro';
import Sidebar from '../components/Sidebar.astro';

const classScripts = [
  {
    title: "01. Consultas SQL",
    desc: [
      "Consultas SQL fundamentales sobre bases de datos relacionales",
      "Uso de SELECT, JOIN, GROUP BY, HAVING y subconsultas",
    ],
    tech: ["SQL", "Oracle"],
    link: "/assets/Scripts/01.Consultas.sql"
  },
  {
    title: "02. Bloques Anónimos PL/SQL",
    desc: [
      "Bloques anónimos en PL/SQL para lógica procedimental",
      "Manejo de variables, condicionales y bucles en Oracle",
    ],
    tech: ["PL/SQL", "Oracle"],
    link: "/assets/Scripts/02.bloquesAnonimos.sql"
  },
  {
    title: "03. Procedimientos Almacenados",
    desc: [
      "Procedimientos almacenados para encapsular lógica de negocio",
      "Uso de parámetros IN, OUT e IN OUT en Oracle PL/SQL",
    ],
    tech: ["PL/SQL", "Oracle"],
    link: "/assets/Scripts/03.procedimientos.sql"
  },
  {
    title: "04. Triggers y Excepciones",
    desc: [
      "Triggers para automatizar acciones ante eventos en la base de datos",
      "Manejo de excepciones predefinidas y definidas por el usuario",
    ],
    tech: ["PL/SQL", "Oracle"],
    link: "/assets/Scripts/04.triggersExcepciones.sql"
  }
];

const talleres = [
  {
    title: "Taller SQL - Santiago Rojas & Estefanía Paredes",
    desc: [
      "Taller de SQL con consultas avanzadas sobre procesos de nómina",
      "Uso de CTEs, DENSE_RANK, SAVEPOINT y control transaccional",
      "Universidad El Bosque",
    ],
    tech: ["SQL", "Oracle"],
    link: "/assets/Scripts/Taller_SQL_SantiagoRojas_EstefaniaParedes.sql"
  },
  {
    title: "Taller PL/SQL - Santiago Rojas & Estefanía Paredes",
    desc: [
      "Taller completo de PL/SQL con procedimientos, funciones y cursores",
      "Manejo de excepciones y diseño de paquetes en Oracle",
      "Universidad El Bosque",
    ],
    tech: ["PL/SQL", "Oracle"],
    link: "/assets/Scripts/Taller_PLSQL_SantiagoRojas_EstefaniaParedes.sql"
  }
];

const projectRepos = [
  {
    title: "Frontend - Nexus",
    desc: [
      "Interfaz de usuario del proyecto desarrollada en equipo",
    ],
    tech: ["Frontend"],
    link: "https://github.com/mariaromero11042004-art/Front-nexus"
  },
  {
    title: "Backend & MySQL",
    desc: [
      "API REST y base de datos relacional del proyecto",
    ],
    tech: ["Backend", "MySQL"],
    link: "https://github.com/Srojas-ga/Backend-Marketplace"
  },
  {
    title: "MongoDB",
    desc: [
      "Base de datos no relacional del proyecto",
    ],
    tech: ["MongoDB"],
    link: "https://github.com/tef333/Proyecto-final-DB2"
  },
  {
    title: "Conexiones MySQL + MongoDB + Frontend + Backend",
    desc: [
      "Integración completa de todas las capas del proyecto",
    ],
    tech: ["MySQL", "MongoDB", "Frontend", "Backend"],
    link: "https://github.com/mariaromero11042004-art/Conexiones-BD-II"
  }
];
---
<!DOCTYPE html>
<html>
  <Header title="Evidence | Santiago Rojas" />
  <body>
    <div class="content">
      <Sidebar selectedItem="personal-projects" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block">
              <img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div>
            </a>
          </div>
          <div class="content-container">
            <h1>Evidence</h1>
            <section class="items-container">
              <div class="resouce-items">

                <h3>Class Exercises</h3>
                {classScripts.map(script => (
                  <div style="margin-bottom: 3rem;">
                    <Project
                      title={script.title}
                      desc={script.desc}
                      tech={script.tech}
                    />
                    <a href={script.link} download
                      style="display:inline-flex; align-items:center; gap:0.4rem; margin-top:0.75rem; padding: 0.5rem 1.2rem; border: 1px solid rgba(255,255,255,0.4); color:white; text-decoration:none; border-radius:6px; font-size:0.85rem; transition: border-color 0.2s;">
                      ⬇ Descargar
                    </a>
                  </div>
                ))}

                <h3>Workshops</h3>
                {talleres.map(taller => (
                  <div style="margin-bottom: 3rem;">
                    <Project
                      title={taller.title}
                      desc={taller.desc}
                      tech={taller.tech}
                    />
                    <a href={taller.link} download
                      style="display:inline-flex; align-items:center; gap:0.4rem; margin-top:0.75rem; padding: 0.5rem 1.2rem; border: 1px solid rgba(255,255,255,0.4); color:white; text-decoration:none; border-radius:6px; font-size:0.85rem; transition: border-color 0.2s;">
                      ⬇ Descargar
                    </a>
                  </div>
                ))}

                <h3>Project Progress</h3>
                {projectRepos.map(project => (
                  <div style="margin-bottom: 3rem;">
                    <Project
                      title={project.title}
                      desc={project.desc}
                      tech={project.tech}
                    />
                    <a href={project.link} target="_blank"
                      style="display:inline-flex; align-items:center; gap:0.4rem; margin-top:0.75rem; padding: 0.5rem 1.2rem; border: 1px solid rgba(255,255,255,0.4); color:white; text-decoration:none; border-radius:6px; font-size:0.85rem; transition: border-color 0.2s;">
                      Ver en GitHub →
                    </a>
                  </div>
                ))}

              </div>
            </section>
          </div>
        </div>
      </nav>
    </div>
    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/files/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
